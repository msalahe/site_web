{% extends 'base.html.twig' %}

{% block title %}Types de Projet{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">
{% endblock %}

{% block body %}
<div class="card">
    <div class="card-body">
        {# En-tête avec bouton créer #}
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="card-title mb-0">{{ title_page }}</h4>
            <button class="btn btn-success add-service" title="Créer un type de projet">
                <i class="bi bi-plus-circle me-2"></i>
                Créer un type
            </button>
        </div>

        {# DataTable #}
        <div class="table-responsive">
            <table id="example" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th style="width: 10%;">#</th>
                        <th>Nom du Type</th>
                        <th style="width: 15%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for type in types %}
                        <tr id="type-row-{{ type.id }}">
                            <td>{{ loop.index }}</td>
                            <td>{{ type.nameType }}</td>
                            <td>
                                {% include 'components/action_buttons.html.twig' with {
                                    'itemId': type.id,
                                    'editCallback': 'edit',
                                    'deleteData': {
                                        'modalId': 'ModalSuppression',
                                        'type': 'type'
                                    }
                                } %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center">Aucun type de projet trouvé</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{# Modal de suppression #}
{% include 'components/delete_modal.html.twig' with {
    'modalId': 'ModalSuppression',
    'title': 'Supprimer le type du projet',
    'message': 'Êtes-vous sûr de vouloir supprimer ce type ? Cette action est irréversible.',
    'confirmBtnId': 'confirmDeleteBtn'
} %}

{# URLs cachées pour JavaScript #}
<input type="hidden" id="add-service-url" value="{{ path('app_type_projet_new') }}">
<input type="hidden" id="edit-service-url" value="{{ path('app_type_projet_edit', {'idType': '__ID__'}) }}">
<input type="hidden" id="create-url" value="{{ path('app_typeprojet_new') }}">
<input type="hidden" id="update-url" value="{{ path('app_typeprojet_edit') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    {{ encore_entry_script_tags('type-management') }}
{% endblock %}
