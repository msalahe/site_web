{% extends 'base.html.twig' %}

{% block title %}Gestion des Projets{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">
{% endblock %}

{% block body %}
<div class="card">
    <div class="card-body">
        {# En-tête avec bouton créer #}
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="card-title mb-0">{{ title_page }}</h4>
            <a href="{{ path('app_projet_new') }}" class="btn btn-success">
                <i class="bi bi-plus-circle me-2"></i>
                Créer un projet
            </a>
        </div>

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {# DataTable #}
        <div class="table-responsive">
            <table id="example" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th style="width: 8%;">#</th>
                        <th>Nom</th>
                        <th style="width: 20%;">Type de Projet</th>
                        <th style="width: 12%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for projet in projets %}
                        <tr id="projet-{{ projet.id }}">
                            <td>{{ loop.index }}</td>
                            <td>
                                <strong>{{ projet.name }}</strong>
                                {% if projet.description %}
                                    <br>
                                    <small class="text-muted">{{ projet.description|length > 50 ? projet.description|slice(0, 50) ~ '...' : projet.description }}</small>
                                {% endif %}
                            </td>
                            <td>
                                {% if projet.type %}
                                    <span class="badge bg-primary">{{ projet.type.nameType }}</span>
                                {% else %}
                                    <span class="badge bg-secondary">Non défini</span>
                                {% endif %}
                            </td>
                            <td>
                                {% include 'components/action_buttons.html.twig' with {
                                    'itemId': projet.id,
                                    'editUrl': path('app_projet_edit', {'id': projet.id}),
                                    'deleteData': {
                                        'modalId': 'ModalSuppression',
                                        'type': 'projet'
                                    }
                                } %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center">
                                <p class="text-muted mb-0">Aucun projet trouvé</p>
                                <a href="{{ path('app_projet_new') }}" class="btn btn-sm btn-outline-primary mt-2">
                                    <i class="bi bi-plus-circle me-1"></i>
                                    Créer le premier projet
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{# Modal de confirmation de suppression #}
{% include 'components/delete_modal.html.twig' with {
    'modalId': 'ModalSuppression',
    'title': 'Supprimer le projet',
    'message': 'Êtes-vous sûr de vouloir supprimer ce projet ? Toutes les images associées seront également supprimées. Cette action est irréversible.',
    'confirmBtnId': 'confirmDeleteBtn'
} %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    {{ encore_entry_script_tags('projet-management') }}
{% endblock %}
